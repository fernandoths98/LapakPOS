generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  owner
  manager
  cashier
  stocker
}

enum BusinessType {
  retail
  restaurant
}

enum OutletType {
  owned
  franchise
}

enum FranchiseStatus {
  active
  ended
}

enum RoyaltyStatementStatus {
  draft
  issued
  paid
}

enum PartnerStatus {
  pending
  active
  ended
}

enum SubscriptionStatus {
  trialing
  active
  past_due
  canceled
}

enum PlanCode {
  free
  starter
  growth
  pro
}

enum ShiftStatus {
  open
  closed
}

enum TenderType {
  cash
  qris
  debit
  split
}

enum SaleStatus {
  completed
  voided
}

enum ExpenseSource {
  manual
  ai_photo
}

enum PpobCategory {
  electricity
  mobile
  water
  health_insurance
  ewallet
  internet_tv
  games
  tv_voucher
  gas
}

enum PpobTransactionStatus {
  pending
  success
  failed
}

enum WalletEntryType {
  topup_credit
  ppob_debit
  ppob_refund
  adjustment
}

enum WalletTopupStatus {
  pending
  paid
  expired
  failed
}

enum RecapKind {
  daily_story
  ask_context
}

enum ChatRole {
  user
  assistant
}

model Merchant {
  id                 String   @id @default(uuid())
  name               String
  address            String?
  phone              String?
  defaultPrinterName String?
  createdAt          DateTime @default(now())
  slug               String?  @unique
  businessType       BusinessType @default(retail) @map("business_type")
  onboardingCompleted Boolean @default(false) @map("onboarding_completed")
  trialEndsAt        DateTime? @map("trial_ends_at")

  users             User[]
  categories        Category[]
  products          Product[]
  shifts            Shift[]
  sales             Sale[]
  expenses          Expense[]
  ppobBillers       PpobBiller[]
  ppobTransactions  PpobTransaction[]
  commissionLedger  PpobCommissionLedgerEntry[]
  wallet             MerchantWallet?
  walletEntries      WalletLedgerEntry[]
  walletTopups       WalletTopup[]
  aiRecapCache      AiRecapCache[]
  aiChatMessages    AiChatMessage[]
  outlets           Outlet[]
  subscription      Subscription?
  subscriptionInvoices SubscriptionInvoice[]
  franchiseAgreements  FranchiseAgreement[]
  franchiseStatements  FranchiseRoyaltyStatement[]
  /// FranchiseePartner rows where this merchant is the franchisor.
  franchisorPartners  FranchiseePartner[] @relation("FranchisorPartners")
  /// The single FranchiseePartner row where this merchant is the franchisee (if any).
  franchiseeLink      FranchiseePartner? @relation("FranchiseeOf")

  @@map("merchants")
}

model User {
  id           String   @id @default(uuid())
  merchantId   String   @map("merchant_id")
  merchant     Merchant @relation(fields: [merchantId], references: [id])
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         UserRole
  outletId     String?  @map("outlet_id")
  outlet       Outlet?  @relation(fields: [outletId], references: [id])
  pinHash      String?  @map("pin_hash")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now())

  shifts         Shift[]
  aiChatMessages AiChatMessage[]

  @@map("users")
}

model Outlet {
  id         String     @id @default(uuid())
  merchantId String     @map("merchant_id")
  merchant   Merchant   @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  name       String
  code       String
  address    String?
  phone      String?
  isPrimary  Boolean    @default(false) @map("is_primary")
  type       OutletType @default(owned)
  timezone   String?
  isActive   Boolean    @default(true) @map("is_active")
  createdAt  DateTime   @default(now()) @map("created_at")
  users      User[]
  outletProducts   OutletProduct[]
  shifts           Shift[]
  sales            Sale[]
  expenses         Expense[]
  ppobTransactions PpobTransaction[]
  franchiseAgreement FranchiseAgreement?

  @@unique([merchantId, code])
  @@index([merchantId])
  @@map("outlets")
}

model Subscription {
  id                 String             @id @default(uuid())
  merchantId         String             @unique @map("merchant_id")
  merchant           Merchant           @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  planCode            PlanCode           @default(free) @map("plan_code")
  status              SubscriptionStatus @default(active)
  trialEndsAt         DateTime?          @map("trial_ends_at")
  currentPeriodEndsAt DateTime?          @map("current_period_ends_at")
  createdAt           DateTime           @default(now()) @map("created_at")
  updatedAt           DateTime           @updatedAt @map("updated_at")

  @@map("subscriptions")
}

/// A pending/paid QRIS invoice to move onto a paid plan. Mirrors WalletTopup:
/// a NusaPay QR is generated, the merchant pays it, and a webhook (or a
/// reconcile poll) flips it to `paid` and activates the plan.
model SubscriptionInvoice {
  id          String            @id @default(uuid())
  merchantId  String            @map("merchant_id")
  merchant    Merchant          @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  planCode    PlanCode          @map("plan_code")
  months      Int               @default(1)
  amount      Int
  partnerRef  String            @unique @map("partner_ref")
  providerRef String?           @map("provider_ref")
  qrContent   String            @map("qr_content")
  status      WalletTopupStatus @default(pending)
  expiresAt   DateTime          @map("expires_at")
  paidAt      DateTime?         @map("paid_at")
  createdAt   DateTime          @default(now()) @map("created_at")

  @@index([merchantId, createdAt])
  @@map("subscription_invoices")
}

model Category {
  id         String   @id @default(uuid())
  merchantId String   @map("merchant_id")
  merchant   Merchant @relation(fields: [merchantId], references: [id])
  name       String
  sortOrder  Int      @default(0) @map("sort_order")

  products Product[]

  @@unique([merchantId, name])
  @@map("categories")
}

model Product {
  id                String   @id @default(uuid())
  merchantId        String   @map("merchant_id")
  merchant          Merchant @relation(fields: [merchantId], references: [id])
  categoryId        String?  @map("category_id")
  category          Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  name              String
  barcode           String?
  sellPrice         Int      @map("sell_price")
  costPrice         Int      @map("cost_price")
  stockQty          Int      @map("stock_qty")
  lowStockThreshold Int      @default(8) @map("low_stock_threshold")
  imageUrl          String?  @map("image_url")
  deletedAt         DateTime? @map("deleted_at")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  costHistory    ProductCostHistory[]
  saleLineItems  SaleLineItem[]
  outletProducts OutletProduct[]

  @@unique([merchantId, barcode])
  @@index([merchantId, name])
  @@map("products")
}

/// Per-outlet state for a catalog product: stock, an optional price override,
/// and whether the outlet offers it at all. `Product` stays the merchant-level
/// identity (name, barcode, category, reference sell/cost price); this table is
/// what a sale decrements and what the Sell screen reads once the app is
/// outlet-aware (Phase 2). During Phase 1 it is populated but not yet read —
/// the app still uses `Product.stockQty`.
model OutletProduct {
  id                String    @id @default(uuid())
  outletId          String    @map("outlet_id")
  outlet            Outlet    @relation(fields: [outletId], references: [id], onDelete: Cascade)
  productId         String    @map("product_id")
  product           Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  stockQty          Int       @default(0) @map("stock_qty")
  lowStockThreshold Int       @default(8) @map("low_stock_threshold")
  priceOverride     Int?      @map("price_override")
  isAvailable       Boolean   @default(true) @map("is_available")
  deletedAt         DateTime? @map("deleted_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@unique([outletId, productId])
  @@index([outletId])
  @@map("outlet_products")
}

model ProductCostHistory {
  id        String   @id @default(uuid())
  productId String   @map("product_id")
  product   Product  @relation(fields: [productId], references: [id])
  oldCost   Int      @map("old_cost")
  newCost   Int      @map("new_cost")
  changedAt DateTime @default(now()) @map("changed_at")

  @@map("product_cost_history")
}

model Shift {
  id            String      @id @default(uuid())
  merchantId    String      @map("merchant_id")
  merchant      Merchant    @relation(fields: [merchantId], references: [id])
  outletId      String      @map("outlet_id")
  outlet        Outlet      @relation(fields: [outletId], references: [id])
  userId        String      @map("user_id")
  user          User        @relation(fields: [userId], references: [id])
  openedAt      DateTime    @default(now()) @map("opened_at")
  closedAt      DateTime?   @map("closed_at")
  openingFloat  Int         @map("opening_float")
  countedCash   Int?        @map("counted_cash")
  expectedCash  Int?        @map("expected_cash")
  status        ShiftStatus @default(open)

  sales            Sale[]
  expenses         Expense[]
  ppobTransactions PpobTransaction[]

  @@index([merchantId, status])
  @@index([outletId, status])
  @@map("shifts")
}

model Sale {
  id             String     @id @default(uuid())
  merchantId     String     @map("merchant_id")
  merchant       Merchant   @relation(fields: [merchantId], references: [id])
  outletId       String     @map("outlet_id")
  outlet         Outlet     @relation(fields: [outletId], references: [id])
  shiftId        String     @map("shift_id")
  shift          Shift      @relation(fields: [shiftId], references: [id])
  orderNo        String     @map("order_no")
  clientId       String     @unique @map("client_id")
  tenderType     TenderType @map("tender_type")
  cashAmount     Int        @map("cash_amount")
  qrisAmount     Int        @map("qris_amount")
  subtotal       Int
  discount       Int        @default(0)
  total          Int
  status         SaleStatus @default(completed)
  createdOffline Boolean    @default(false) @map("created_offline")
  createdAt      DateTime   @default(now()) @map("created_at")
  syncedAt       DateTime?  @map("synced_at")

  lineItems SaleLineItem[]

  @@index([merchantId, createdAt])
  @@index([outletId, createdAt])
  @@map("sales")
}

model SaleLineItem {
  id                  String  @id @default(uuid())
  saleId              String  @map("sale_id")
  sale                Sale    @relation(fields: [saleId], references: [id])
  productId           String  @map("product_id")
  product             Product @relation(fields: [productId], references: [id])
  productNameSnapshot String  @map("product_name_snapshot")
  unitPriceSnapshot   Int     @map("unit_price_snapshot")
  qty                 Int
  lineTotal           Int     @map("line_total")

  @@index([saleId])
  @@map("sale_line_items")
}

model Expense {
  id         String        @id @default(uuid())
  merchantId String        @map("merchant_id")
  merchant   Merchant      @relation(fields: [merchantId], references: [id])
  outletId   String        @map("outlet_id")
  outlet     Outlet        @relation(fields: [outletId], references: [id])
  shiftId    String?       @map("shift_id")
  shift      Shift?        @relation(fields: [shiftId], references: [id])
  amount     Int
  note       String?
  photoUrl   String?       @map("photo_url")
  source     ExpenseSource @default(manual)
  createdAt  DateTime      @default(now()) @map("created_at")

  @@index([outletId, createdAt])
  @@map("expenses")
}

model PpobBiller {
  id           String       @id @default(uuid())
  merchantId   String       @map("merchant_id")
  merchant     Merchant     @relation(fields: [merchantId], references: [id])
  code         String
  name         String
  sub          String
  category     PpobCategory
  marginAmount Int          @map("margin_amount")
  isActive     Boolean      @default(true) @map("is_active")

  transactions PpobTransaction[]

  @@unique([merchantId, code])
  @@map("ppob_billers")
}

model PpobTransaction {
  id              String                 @id @default(uuid())
  merchantId      String                 @map("merchant_id")
  merchant        Merchant               @relation(fields: [merchantId], references: [id])
  outletId        String                 @map("outlet_id")
  outlet          Outlet                 @relation(fields: [outletId], references: [id])
  billerId        String                 @map("biller_id")
  biller          PpobBiller             @relation(fields: [billerId], references: [id])
  shiftId         String                 @map("shift_id")
  shift           Shift                  @relation(fields: [shiftId], references: [id])
  customerNumber  String                 @map("customer_number")
  customerName    String                 @map("customer_name")
  billAmount      Int                    @map("bill_amount")
  adminFee        Int                    @map("admin_fee")
  marginAmount    Int                    @map("margin_amount")
  totalCharged    Int                    @map("total_charged")
  providerRef     String                 @map("provider_ref")
  status          PpobTransactionStatus  @default(pending)
  createdAt       DateTime               @default(now()) @map("created_at")
  walletDebitAmount Int                  @default(0) @map("wallet_debit_amount")
  walletReference String?                @unique @map("wallet_reference")

  commissionEntry PpobCommissionLedgerEntry?

  @@index([merchantId, createdAt])
  @@index([outletId, createdAt])
  @@map("ppob_transactions")
}

model MerchantWallet {
  merchantId String   @id @map("merchant_id")
  merchant   Merchant @relation(fields: [merchantId], references: [id])
  balance    Int      @default(0)
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("merchant_wallets")
}

model WalletLedgerEntry {
  id           String          @id @default(uuid())
  merchantId   String          @map("merchant_id")
  merchant     Merchant        @relation(fields: [merchantId], references: [id])
  type         WalletEntryType
  amount       Int
  balanceAfter Int             @map("balance_after")
  reference    String          @unique
  description  String
  createdAt    DateTime        @default(now()) @map("created_at")

  @@index([merchantId, createdAt])
  @@map("wallet_ledger_entries")
}

model WalletTopup {
  id           String            @id @default(uuid())
  merchantId   String            @map("merchant_id")
  merchant     Merchant          @relation(fields: [merchantId], references: [id])
  amount       Int
  partnerRef   String            @unique @map("partner_ref")
  providerRef  String?           @map("provider_ref")
  qrContent    String            @map("qr_content")
  status       WalletTopupStatus @default(pending)
  expiresAt    DateTime          @map("expires_at")
  paidAt       DateTime?         @map("paid_at")
  createdAt    DateTime          @default(now()) @map("created_at")

  @@index([merchantId, createdAt])
  @@map("wallet_topups")
}

model PpobCommissionLedgerEntry {
  id                String          @id @default(uuid())
  merchantId        String          @map("merchant_id")
  merchant          Merchant        @relation(fields: [merchantId], references: [id])
  ppobTransactionId String          @unique @map("ppob_transaction_id")
  ppobTransaction   PpobTransaction @relation(fields: [ppobTransactionId], references: [id])
  commissionAmount  Int             @map("commission_amount")
  depositDelta      Int             @map("deposit_delta")
  createdAt         DateTime        @default(now()) @map("created_at")

  @@map("ppob_commission_ledger")
}

/// Terms for one franchise outlet: what royalty % of gross sales and what
/// fixed monthly fee the franchisee owes the franchisor, and whether the
/// franchisee may set its own per-outlet prices (`allowPriceOverride`).
model FranchiseAgreement {
  id                 String          @id @default(uuid())
  merchantId         String          @map("merchant_id")
  merchant           Merchant        @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  outletId           String          @unique @map("outlet_id")
  outlet             Outlet          @relation(fields: [outletId], references: [id], onDelete: Cascade)
  royaltyPercent     Int             @default(0) @map("royalty_percent")
  feeMonthly         Int             @default(0) @map("fee_monthly")
  allowPriceOverride Boolean         @default(false) @map("allow_price_override")
  startDate          DateTime        @map("start_date")
  status             FranchiseStatus @default(active)
  notes              String?
  createdAt          DateTime        @default(now()) @map("created_at")
  updatedAt          DateTime        @updatedAt @map("updated_at")

  statements FranchiseRoyaltyStatement[]

  @@index([merchantId])
  @@map("franchise_agreements")
}

/// A generated royalty bill for one franchise outlet + period:
/// `royaltyDue = grossSales * royaltyPercent / 100`, `feeDue = feeMonthly`.
/// Recording only — payment collection is out of scope for now.
model FranchiseRoyaltyStatement {
  id          String                 @id @default(uuid())
  agreementId String                 @map("agreement_id")
  agreement   FranchiseAgreement     @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  merchantId  String                 @map("merchant_id")
  merchant    Merchant               @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  outletId    String                 @map("outlet_id")
  periodStart DateTime               @map("period_start")
  periodEnd   DateTime               @map("period_end")
  grossSales  Int                    @map("gross_sales")
  royaltyDue  Int                    @map("royalty_due")
  feeDue      Int                    @map("fee_due")
  totalDue    Int                    @map("total_due")
  status      RoyaltyStatementStatus @default(draft)
  issuedAt    DateTime?              @map("issued_at")
  paidAt      DateTime?              @map("paid_at")
  createdAt   DateTime               @default(now()) @map("created_at")

  @@unique([agreementId, periodStart])
  @@index([merchantId, periodStart])
  @@map("franchise_royalty_statements")
}

/// An inter-tenant franchise link: another business (`franchisee`) runs
/// under this merchant's (`franchisor`) brand with its own login, plan and
/// catalog. Created as `pending` with a `joinCode` the franchisee redeems.
/// This is the tenant-level counterpart to the intra-merchant
/// `FranchiseAgreement` (which is just a franchise *branch* you operate).
model FranchiseePartner {
  id                   String        @id @default(uuid())
  franchisorMerchantId String        @map("franchisor_merchant_id")
  franchisor           Merchant      @relation("FranchisorPartners", fields: [franchisorMerchantId], references: [id], onDelete: Cascade)
  franchiseeMerchantId String?       @unique @map("franchisee_merchant_id")
  franchisee           Merchant?     @relation("FranchiseeOf", fields: [franchiseeMerchantId], references: [id], onDelete: SetNull)
  label                String?
  joinCode             String        @unique @map("join_code")
  royaltyPercent       Int           @default(0) @map("royalty_percent")
  feeMonthly           Int           @default(0) @map("fee_monthly")
  status               PartnerStatus @default(pending)
  joinedAt             DateTime?     @map("joined_at")
  lastCatalogSyncAt    DateTime?     @map("last_catalog_sync_at")
  createdAt            DateTime      @default(now()) @map("created_at")
  updatedAt            DateTime      @updatedAt @map("updated_at")

  statements FranchiseePartnerStatement[]

  @@index([franchisorMerchantId])
  @@map("franchisee_partners")
}

/// A royalty bill from a franchisor to a franchisee tenant for one period,
/// computed from the franchisee merchant's own completed sales across all
/// its outlets. `royaltyDue = grossSales * royaltyPercent / 100`.
model FranchiseePartnerStatement {
  id                   String                 @id @default(uuid())
  partnerId            String                 @map("partner_id")
  partner              FranchiseePartner      @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  franchisorMerchantId String                 @map("franchisor_merchant_id")
  franchiseeMerchantId String                 @map("franchisee_merchant_id")
  periodStart          DateTime               @map("period_start")
  periodEnd            DateTime               @map("period_end")
  grossSales           Int                    @map("gross_sales")
  royaltyDue           Int                    @map("royalty_due")
  feeDue               Int                    @map("fee_due")
  totalDue             Int                    @map("total_due")
  status               RoyaltyStatementStatus @default(draft)
  issuedAt             DateTime?              @map("issued_at")
  paidAt               DateTime?             @map("paid_at")
  createdAt            DateTime               @default(now()) @map("created_at")

  @@unique([partnerId, periodStart])
  @@index([franchisorMerchantId, periodStart])
  @@index([franchiseeMerchantId])
  @@map("franchisee_partner_statements")
}

model AiRecapCache {
  id              String    @id @default(uuid())
  merchantId      String    @map("merchant_id")
  merchant        Merchant  @relation(fields: [merchantId], references: [id])
  recapDate       DateTime  @db.Date @map("recap_date")
  kind            RecapKind
  promptInputJson Json      @map("prompt_input_json")
  responseJson    Json      @map("response_json")
  model           String
  createdAt       DateTime  @default(now()) @map("created_at")

  @@unique([merchantId, recapDate, kind])
  @@map("ai_recap_cache")
}

model AiChatMessage {
  id         String   @id @default(uuid())
  merchantId String   @map("merchant_id")
  merchant   Merchant @relation(fields: [merchantId], references: [id])
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id])
  role       ChatRole
  content    String
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([merchantId, userId, createdAt])
  @@map("ai_chat_messages")
}
