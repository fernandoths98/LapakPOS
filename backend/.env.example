# Postgres connection used by Prisma
DATABASE_URL="postgresql://lapak:lapak@localhost:5432/lapak?schema=public"

# Auth
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

# Server
PORT=3000

# AI recap (Anthropic Claude). Leave unset to run with AI features gracefully disabled.
ANTHROPIC_API_KEY=

# PPOB provider: "mock" is the only implementation shipped for now.
PPOB_PROVIDER="mock"

# Seed script
SEED_OWNER_EMAIL="owner@lapak.test"
SEED_OWNER_PASSWORD="lapak12345"
SEED_CASHIER_EMAIL="sari@lapak.test"
SEED_CASHIER_PASSWORD="lapak12345"
