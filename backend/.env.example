# Copy to backend/.env and fill in real values. Never commit backend/.env.
# NOTE: previous revisions of this file contained real production credentials.
# Those must be rotated (Supabase DB password + JWT_SECRET) — a scrub of this
# file alone does not remove them from git history.

# Postgres connection used by Prisma (Supabase session-pooler host, port 5432).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# Auth — any long random string; changing it invalidates all existing logins.
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

# Server
PORT=3000

# AI recap (Anthropic Claude). Leave unset to run with AI features gracefully disabled.
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4-5

# PPOB provider: "mock", or "digiflazz" with its keys.
PPOB_PROVIDER="mock"

# Seed script (local/dev only).
SEED_OWNER_EMAIL="owner@lapak.test"
SEED_OWNER_PASSWORD="change-me"
SEED_CASHIER_EMAIL="sari@lapak.test"
SEED_CASHIER_PASSWORD="change-me"
